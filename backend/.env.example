DJANGO_SECRET_KEY=generate-a-unique-secret-for-this-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Origines HTTPS de confiance pour les formulaires Django/CSRF (facultatif).
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_ENGINE=postgres
DB_NAME=kawastock
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
